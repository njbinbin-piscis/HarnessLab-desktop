# Copy to .env and fill in your credentials:
#   cp .env.example .env

# LLM provider (qwen uses DashScope compatible-mode endpoint)
PISCIS_PROVIDER=qwen
PISCIS_API_KEY=sk-your-key-here
PISCIS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Default model id used by platform configs (override per YAML agent.model)
PISCIS_DEFAULT_MODEL=qwen3.6-plus
