{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HarnessLab",
  "mainBinaryName": "harnesslab-desktop",
  "version": "0.2.1",
  "identifier": "com.harnesslab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HarnessLab",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Design, run and ship multi-agent harnesses.",
    "longDescription": "HarnessLab Desktop — a Tauri v2 desktop app to visually design pluggable agent harnesses and multi-agent systems, run experiments, and generate runnable codebases. Native Rust runtime (harness-rt).",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libsoup-3.0-0",
          "libjavascriptcoregtk-4.1-0",
          "librsvg2-2",
          "libgtk-3-0"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
